import speech_recognition as sr
import pyttsx3
from openai import OpenAI

# Initialize the OpenAI client (Ensure your API key is set here)
client = OpenAI(api_key="YOUR_OPENAI_API_KEY")

# Initialize the Windows Text-to-Speech engine
engine = pyttsx3.init()

# Optimize voice settings for natural pacing
voices = engine.getProperty('voices')
engine.setProperty('voice', voices[1].id)  # 1 is usually female, 0 is male
engine.setProperty('rate', 190)             # Slightly faster rate for complex data

# This array acts as the AI's short-term memory
conversation_memory = [
    {
        "role": "system", 
        "content": "You are a highly intelligent, powerful Windows voice assistant. "
                   "You handle complex logic, coding, and analytical questions. "
                   "Keep answers comprehensive but structured and easy to understand when spoken aloud."
    }
]

def speak_and_print_stream(prompt):
    """Sends prompt to ChatGPT, streams text to console, and speaks it seamlessly."""
    global conversation_memory
    
    # Append the new user question to memory
    conversation_memory.append({"role": "user", "content": prompt})
    
    print("AI: ", end="", flush=True)
    full_response = ""
    sentence_buffer = ""

    try:
        # Request a streaming response for complex queries
        stream = client.chat.completions.create(
            model="gpt-4o",  # Upgraded to the flagship model for complex reasoning
            messages=conversation_memory,
            stream=True
        )

        for chunk in stream:
            if chunk.choices[0].delta.content:
                text_chunk = chunk.choices[0].delta.content
                print(text_chunk, end="", flush=True)  # Print text as it arrives
                
                full_response += text_chunk
                sentence_buffer += text_chunk
                
                # Speak sentence-by-sentence so the user doesn't wait for the full response
                if any(char in text_chunk for char in [".", "!", "?", "\n"]):
                    clean_sentence = sentence_buffer.strip().replace("*", "").replace("#", "")
                    if clean_sentence:
                        engine.say(clean_sentence)
                        engine.runAndWait()
                    sentence_buffer = ""

        # Speak any remaining text left in the buffer
        if sentence_buffer.strip():
            engine.say(sentence_buffer.strip().replace("*", "").replace("#", ""))
            engine.runAndWait()
            
        print() # New line after stream finishes
        
        # Save the AI's response to memory so it remembers it next time
        conversation_memory.append({"role": "assistant", "content": full_response})

    except Exception as e:
        error_msg = f"Error communicating with OpenAI: {str(e)}"
        print(f"\n{error_msg}")
        engine.say("I encountered an error trying to process that.")
        engine.runAndWait()

def listen_to_user():
    """Advanced audio processing with dynamic energy thresholds."""
    recognizer = sr.Recognizer()
    # Boost limits for complex, longer user prompts
    recognizer.phrase_threshold = 0.8  
    recognizer.pause_threshold = 1.5   # Allows you to pause and think without cutting off

    with sr.Microphone() as source:
        print("\n⚡ Listening for your question... (Say 'exit' to quit)")
        recognizer.adjust_for_ambient_noise(source, duration=1.5)
        audio = recognizer.listen(source, timeout=10, phrase_time_limit=30)

    try:
        print("Analyzing complex audio...")
        user_text = recognizer.recognize_google(audio)
        print(f"You: {user_text}")
        return user_text
    except sr.UnknownValueError:
        return None
    except sr.RequestError:
        print("Network error with transcription service.")
        return None
def main():
    print("Initializing Flagship Intelligence Assistant...")
    engine.say("System online. Ready for complex queries.")
    engine.runAndWait()
    
    while True:
        user_input = listen_to_user()
        
        if user_input:
            if "exit" in user_input.lower() or "terminate" in user_input.lower():
                engine.say("Shutting down systems. Goodbye.")
                engine.runAndWait()
                break
                
            # Send question, remember context, and stream back
            speak_and_print_stream(user_input)

if name == "main":
    main()
